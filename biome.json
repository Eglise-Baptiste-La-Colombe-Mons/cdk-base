{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!**/build",
			"!**/dist",
			"!**/cdk.out",
			"!**/*.md",
			"!**/*.yml",
			"!**/*.yaml"
		]
	},
	"formatter": {
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "off"
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
