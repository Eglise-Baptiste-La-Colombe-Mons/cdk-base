{
	"name": "cdk-base",
	"version": "0.0.0",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "yarn@4.18.1",
	"workspaces": [
		"packages/cdk/*",
		"packages/tools/*"
	],
	"scripts": {
		"postinstall": "husky",
		"build": "turbo run build",
