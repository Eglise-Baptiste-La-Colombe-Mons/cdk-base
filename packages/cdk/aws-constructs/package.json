{
	"name": "@lacolombemons/aws-constructs",
	"version": "0.3.0",
	"description": "Constructs AWS CDK des projets La Colombe Mons, avec les réglages par défaut issus d'ecodim.",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "https://github.com/Eglise-Baptiste-La-Colombe-Mons/cdk-base.git",
		"directory": "packages/cdk/aws-constructs"
	},
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"files": [
		"build"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc --build",
		"package": "mkdir -p dist/js && yarn pack --out dist/js/aws-constructs.tgz"
	},
	"peerDependencies": {
		"aws-cdk-lib": "^2.274.0",
		"constructs": "^10.8.1"
	},
	"devDependencies": {
		"@lacolombemons/tsconfig": "workspace:^",
		"@types/node": "^26",
		"aws-cdk-lib": "2.277.0",
		"constructs": "^10.8.1",
		"typescript": "~7.0.2"
	}
}
