{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts", "tsconfig.json", "package.json"],
			"outputs": ["build/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
		},
		"package": {
			"dependsOn": ["build"],
			"outputs": ["dist/**"]
		}
	}
}
